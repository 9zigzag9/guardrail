<mxfile host="drawio"><diagram id="architecture" name="Architecture"><mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1440" pageHeight="820" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Prompt Injection Guardrail: architecture&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1400" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Browser: React website (frontend/)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=16;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="330" height="700" as="geometry"/></mxCell><mxCell id="c4" value="FastAPI back end (backend/)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=16;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="540" height="700" as="geometry"/></mxCell><mxCell id="c5" value="Files on the server" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=16;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1070" y="60" width="350" height="700" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;PromptForm.jsx&lt;/b&gt;&lt;br&gt;checks the text is not blank&lt;br&gt;and at most 10,000 characters" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="290" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;api.js&lt;/b&gt;&lt;br&gt;adds a random X-Session-Id per tab&lt;br&gt;15 second time limit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="290" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Result and history views&lt;/b&gt;&lt;br&gt;ResultCard, HighlightedText&lt;br&gt;(user text shown as plain text, never HTML)&lt;br&gt;SessionChart, CategoryChart, HistoryPanel" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="290" height="105" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Our data page&lt;/b&gt;&lt;br&gt;DataPage.jsx" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="645" width="290" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Middleware&lt;/b&gt; (runs first on every request)&lt;br&gt;CORS: only the website's own address&lt;br&gt;Security headers: CSP, nosniff, frame DENY, no-store&lt;br&gt;Body size limit: 64 KB, refused before reading&lt;br&gt;One JSON error format, never a stack trace" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="460" y="105" width="500" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Pydantic validation&lt;/b&gt;: 1 to 10,000 characters, else 422" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="225" width="500" height="40" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Admission control&lt;/b&gt;  run_inference()&lt;br&gt;at most 2 running + 8 waiting, else 503 + Retry-After; 5 s limit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="285" width="500" height="55" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Worker process pool&lt;/b&gt;  inference.py&lt;br&gt;clean text (folds look-alike letters) → features → model → explain()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="360" width="500" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;CheckResponse&lt;/b&gt;&lt;br&gt;decision, confidence, category,&lt;br&gt;highlights, explanation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="450" width="235" height="75" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;history.py&lt;/b&gt;&lt;br&gt;parameterised SQL only&lt;br&gt;scoped to the browser session" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="725" y="450" width="235" height="75" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;model_stats.py&lt;/b&gt;&lt;br&gt;reads the training results; serves a fixed list of chart images" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="645" width="500" height="60" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;backend/model/&lt;/b&gt;&lt;br&gt;guardrail_model.joblib, category_model.joblib&lt;br&gt;SHA-256 checked at startup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1090" y="250" width="310" height="80" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;ml/prompt_injection_guardrail.py&lt;/b&gt;&lt;br&gt;cleaning, features and explanation code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1090" y="350" width="310" height="60" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;backend/data/history.db&lt;/b&gt;&lt;br&gt;SQLite: past checks,&lt;br&gt;kept separate per browser session" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1090" y="450" width="310" height="75" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;outputs/&lt;/b&gt;&lt;br&gt;training results and charts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1090" y="645" width="310" height="60" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value='&lt;b&gt;POST /api/check&lt;/b&gt;&lt;br&gt;{"text": "..."}' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;endArrow=block;endFill=1;stro