# Environment variables the API reads, with their defaults. Set any you want to change in your shell
# before starting uvicorn (PowerShell: $env:MAX_QUEUED="4"). Never put real secrets in this file.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_TEXT_CHARS=10000
MAX_BODY_BYTES=65536
INFERENCE_WORKERS=2
MAX_QUEUED=8
INFERENCE_TIMEOUT_S=5
ENABLE_DOCS=true
HISTORY_DB=backend/data/history.db
HISTORY_KEEP=200
MODEL_DIR=backend/model
OUTPUTS_DIR=outputs
